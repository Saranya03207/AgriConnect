# AWS Region
AWS_REGION=us-east-1

# DynamoDB
DYNAMODB_TABLE_MAIN=AgriConnect-Main
DYNAMODB_TABLE_ANALYTICS=AgriConnect-Analytics

# S3
S3_BUCKET=agriconnect-media-dev
S3_REGION=us-east-1

# Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# SNS
SNS_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:agriconnect-notifications

# EventBridge
EVENTBRIDGE_BUS_NAME=agriconnect-event-bus

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Amazon Location Service
LOCATION_MAP_NAME=AgriConnectMap
LOCATION_PLACE_INDEX=AgriConnectPlaceIndex
LOCATION_ROUTE_CALCULATOR=AgriConnectRouteCalculator

# App
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:3000
