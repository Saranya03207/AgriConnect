# API
VITE_API_BASE_URL=https://api.agriconnect.io/v1

# AWS Cognito
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# AWS Amplify / S3
VITE_S3_BUCKET=agriconnect-media-dev
VITE_S3_REGION=us-east-1

# Amazon Location Service
VITE_LOCATION_MAP_NAME=AgriConnectMap
VITE_LOCATION_REGION=us-east-1

# Feature flags
VITE_ENABLE_AI_ADVISOR=true
VITE_ENABLE_LOGISTICS=true
